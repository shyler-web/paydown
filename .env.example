# Copy to .env and fill in. NEVER commit .env itself.

# --- FalkorDB (the load-bearing graph database) ---
# Host-run dev: localhost. Inside docker compose the backend sets
# FALKORDB_HOST=falkordb / FALKORDB_PORT=6379 automatically (see docker-compose.yml).
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# --- Cockpit dev proxy (F1) ---
# Where Vite forwards /api/* in `npm run dev`. Default http://localhost:8000;
# unused by the compose build (nginx proxies to http://backend:8000 instead).
VITE_PROXY_TARGET=http://localhost:8000

# --- LLM (Nebius Token Factory — OpenAI-compatible) ---
# Nebius replaces Gemini as the LLM provider. Put your key here (never commit .env).
NEBIUS_API_KEY=
# Optional overrides (defaults shown):
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B   # any NVIDIA/NIM model id you have access to

# --- Tools (web-search grounding, replaces Gemini google_search) ---
TAVILY_API_KEY=

# --- Observability (LangSmith tracing) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=graphhacks-track02
# --- Clarify: cognitive-debt refactor (optional; A/B/E scoring is tokenless) ---
CLARIFY_MODEL=                        # defaults to NEBIUS_MODEL
CLARIFY_DOCKER_IMAGE=python:3.12-slim
CLARIFY_MIN_SCORE_DROP=1.0
CLARIFY_MAX_SOURCE_CHARS=60000

# --- Repo cache + PR delivery ---
REPO_CACHE_DIR=                       # defaults to ~/.graphhacks-repos
GITHUB_TOKEN=                         # only needed for --publish
GITHUB_REPO=                          # owner/name for PR delivery
GITHUB_BASE=master